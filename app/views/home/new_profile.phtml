<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>BrewHub - Cadastro de Usuário</title>
    <link rel="icon" type="image/png" href="../assets/icons/favicon.ico" />

    <!-- Bootstrap CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <!-- Estilo Customizado -->
    <link rel="stylesheet" href="../aplications/css/style.css" />
  </head>
  <body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light bg-navbar shadow-sm">
      <div class="container">
        <a class="navbar-brand text-brown fw-bold" href="#">BrewHub</a>
        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#navbarNav"
        >
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav ms-auto">
            <li class="nav-item">
              <a class="nav-link text-brown" href="#">Criação de Receita</a>
            </li>
            <li class="nav-item">
              <a class="nav-link text-brown" href="#">Cadastro de Insumos</a>
            </li>
            <li class="nav-item">
              <a class="nav-link text-brown active" href="#"
                >Cadastro de Usuário</a
              >
            </li>
            <li class="nav-item">
              <a class="nav-link text-brown" href="#">Extração de Relatório</a>
            </li>
            <li class="nav-item">
              <a class="nav-link text-brown" href="#">Testes de Versão</a>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <!-- Formulário -->
    <div class="container py-5">
      <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 bg-light shadow rounded-4 p-4">
          <h2 class="text-center text-brown mb-4">Cadastro de Usuário</h2>
          <form>
            <div class="mb-3">
              <label class="form-label text-brown">Nome de Usuário</label>
              <input type="text" class="form-control" required />
            </div>
            <div class="mb-3">
              <label class="form-label text-brown">E-mail</label>
              <input type="email" class="form-control" required />
            </div>
            <div class="mb-3">
              <label class="form-label text-brown">Senha</label>
              <input type="password" class="form-control" required />
            </div>
            <div class="mb-3">
              <label class="form-label text-brown">Confirmação de Senha</label>
              <input type="password" class="form-control" required />
            </div>
            <div class="mb-3">
              <label class="form-label text-brown">Tipo de Usuário</label>
              <select class="form-select">
                <option>Auxiliar Cervejeiro</option>
                <option>Mestre Cervejeiro</option>
                <option>Super Admin</option>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label text-brown">Permissões</label>
              <div class="form-check">
                <input class="form-check-input" type="checkbox" id="receita" />
                <label class="form-check-label" for="receita"
                  >Tela de Criação de Receita</label
                >
              </div>
              <div class="form-check">
                <input class="form-check-input" type="checkbox" id="insumos" />
                <label class="form-check-label" for="insumos"
                  >Cadastro de Insumos</label
                >
              </div>
              <div class="form-check">
                <input class="form-check-input" type="checkbox" id="usuarios" />
                <label class="form-check-label" for="usuarios"
                  >Cadastro de Usuários</label
                >
              </div>
              <div class="form-check">
                <input
                  class="form-check-input"
                  type="checkbox"
                  id="relatorio"
                />
                <label class="form-check-label" for="relatorio"
                  >Extração de Relatório</label
                >
              </div>
              <div class="form-check">
                <input class="form-check-input" type="checkbox" id="versao" />
                <label class="form-check-label" for="versao"
                  >Testes de Versão</label
                >
              </div>
            </div>
            <button type="submit" class="btn btn-brown w-100">Cadastrar</button>
          </form>
        </div>
      </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
